# Delala Next.js — Vercel / local environment placeholders.
# Copy to `.env.local` for local development (gitignored).
# On Vercel, set these in Project → Settings → Environment Variables.
# NEVER put Firebase Admin / Django secrets here. NEVER commit real secrets.

# Django API base URL (no trailing slash). Local fallback is http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: public media host for next/image (Cloudflare R2 custom domain or *.r2.dev).
# Use https://media.yourdomain.com or https://pub-xxxxx.r2.dev
# If unset, next.config derives hosts from NEXT_PUBLIC_API_URL only.
# NEXT_PUBLIC_MEDIA_URL=https://media.yourdomain.com

# Optional: extra comma-separated image hostnames for next/image (no scheme).
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.yourdomain.com,pub-xxxxx.r2.dev

# Firebase web app config (Firebase Console → Project settings → Your apps).
# These are client-side public config values, not Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
