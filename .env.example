# Delala Django — environment variable names for local / production.
# Copy to `.env` for local overrides (loaded by delala/settings.py).
# On Render, set these in the service Environment dashboard.
# NEVER commit real secrets. Values below are placeholders only.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------

# Required in production (DJANGO_DEBUG=False). Optional locally (dev fallback exists).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Local default when unset: True. Production (Render): False
DJANGO_DEBUG=True

# Comma-separated hostnames. Local default: 127.0.0.1,localhost
# Production example: delala-api.onrender.com,api.yourdomain.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated frontend origins for credentialed CORS (scheme + host + port).
# Local default: http://127.0.0.1:3000,http://localhost:3000
# Production (Vercel): https://your-app.vercel.app,https://yourdomain.com
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Comma-separated CSRF trusted origins (scheme + host + port).
# Must include the same Vercel / custom frontend origins as CORS.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---------------------------------------------------------------------------
# Cookies — required for split Vercel (frontend) + Render (API) sessions
# ---------------------------------------------------------------------------
# Local HTTP: Secure=False, SameSite=Lax
# Production HTTPS cross-site (Vercel ↔ Render): Secure=True, SameSite=None
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# HTTPS / proxy (Render terminates TLS — enable these in production)
# ---------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True

# Set True on Render so Django trusts X-Forwarded-Proto from the proxy.
DJANGO_SECURE_PROXY_SSL_HEADER=False

# ---------------------------------------------------------------------------
# Database — unset = local SQLite (db.sqlite3). Production: Render DATABASE_URL.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Optional overrides when DATABASE_URL is set:
# DJANGO_DB_CONN_MAX_AGE=600
# DJANGO_DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Media — local MEDIA_ROOT when S3/R2 is off; Cloudflare R2 when enabled
# ---------------------------------------------------------------------------
# Set DJANGO_USE_S3_MEDIA=True on Render (or set all AWS_* below to auto-enable).
DJANGO_USE_S3_MEDIA=False
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_STORAGE_BUCKET_NAME=delala-media
# AWS_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# Public hostname for object URLs (R2 custom domain or *.r2.dev) — host only or https://host
# AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only). Never commit keys. Never use NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
# Local: path to service-account JSON (absolute or relative to project root).
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json
# Render: paste the full service-account JSON as a single-line env var instead:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Optional: Firebase project id used to validate the ID token audience.
FIREBASE_PROJECT_ID=your-firebase-project-id
